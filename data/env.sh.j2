# If you see this output, you probably forgot to pipe it into `source`:
# nix-your-shell | source /dev/stdin

function nix-shell () {
    {{ executable }} {{ extra_args | join(" ") }} {{ shell }} nix-shell -- "$@"
}

function nix () {
    {{ executable }} {{ extra_args | join(" ") }} {{ shell }} nix -- "$@"
}

{% if info_right and shell is endingwith("zsh") %}
precmd () {
    local with_codes=$({{ executable }} {{ shell }} shell-info)
    local without_codes=$(printf "$with_codes" | sed -r "s/\x1B\[([0-9]{1,2}(;[0-9]{1,2})?)?[m|K]//g")
    RPROMPT=%${#without_codes}{$with_codes%}
}
{% endif %}
